{
  "name": "grudge-cli",
  "version": "0.1.5",
  "description": "Local, deterministic guards for recurring agent mistakes.",
  "type": "module",
  "bin": {
    "grudge": "dist/grudge.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harshithKumar12/Grudge.git"
  },
  "homepage": "https://github.com/harshithKumar12/Grudge#readme",
  "bugs": {
    "url": "https://github.com/harshithKumar12/Grudge/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "setup:repo": "node dist/grudge.mjs setup --cwd ../.. --yes --agents claude-code --scope repo",
    "doctor:repo": "node dist/grudge.mjs doctor --cwd ../..",
    "uninstall:repo": "node dist/grudge.mjs uninstall --cwd ../.."
  },
  "license": "MIT"
}
