# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local environments and generated Python artifacts.
.venv/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
*.egg-info/
.grudge/
build/
dist/
.opencode/
release-dist/

# Claude Code personal settings are machine-local and must never be committed
# (they hold absolute paths to this workstation's node and install). The shared
# `.claude/settings.json` stays trackable on purpose: Claude Code defines it as
# the file a repository ships, so the directory itself is not ignored.
.claude/settings.local.json
.grudge/session/
.grudge/stats.json
.grudge/*.log
